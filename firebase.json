{
  "hosting": {
    "public": "hosting-redirect",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/app/:rest*",
        "destination": "https://rippl.aarush-uae.workers.dev/app/:rest*",
        "type": 301
      },
      {
        "source": "**",
        "destination": "https://rippl.aarush-uae.workers.dev/app",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
