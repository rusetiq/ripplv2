{
  "name": "ripplv2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:client": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rippl --local",
    "db:migrate": "wrangler d1 migrations apply rippl --remote",
    "db:console": "wrangler d1 execute rippl --remote --command",
    "import:firestore": "node scripts/firestore-export.mjs",
    "import:d1": "node scripts/d1-import.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "framer-motion": "^12.38.0",
    "hono": "^4.13.7",
    "html-to-image": "^1.11.13",
    "lenis": "^1.3.26",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.4.0",
    "globals": "^17.6.0",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "gaxios@6": {
      "uuid": "^11.1.1"
    }
  }
